      "id": "scene26",
      "background": "bg_st1_sc2",
      "backgroundBlur": true,
      "characterImage": "ch_st1_sc18",
      "characterPlacement": {
        "width": 360,
        "height": null,
        "xOffset": 0,
        "yOffset": 0
      },
      "voiceover": "20",
      "speaker": null,
      "text": "Encep, Hotma, Waha, dan Boaz menikmati permainan congklak itu. Mereka senang memainkannya. Mereka memainkan congkak secara bergiliran.",
      "choices": null,
      "next": "scene27"
