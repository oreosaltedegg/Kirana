      "characterPlacement": {
        "width": 257,
        "height": null,
        "xOffset": -5,
        "yOffset": -15
      },
      "speaker": null,
      "text": "Karena kecerobohannya, Boaz pun dimarahi Hotma. Boaz sekarang sedih dan tidak nafsu makan.",
