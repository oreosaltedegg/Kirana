        "height": null,
        "xOffset": 0,
        "yOffset": 5
      },
      "voiceover": "15",
      "speaker": "Encep",
      "text": "Daku adalah salah satu permainan tradisional, Waha. Kita bisa bermain daku secara berpasangan.",
