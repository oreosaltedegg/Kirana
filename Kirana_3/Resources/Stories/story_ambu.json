      "characterPlacement": {
        "width": 250,
        "height": null,
        "xOffset": 0,
        "yOffset": -25
      },
      "voiceover": "jessi2",
      "speaker": "Hotma",
      "text": "Wahh, aku pernah memainkannya dulu di kampung halamanku. Namanya congklak. Kok jadi daku?",
      "choices": null,
      "next": "scene20"
    },
    {
      "id": "scene20",
      "background": "bg_st1_sc2",
