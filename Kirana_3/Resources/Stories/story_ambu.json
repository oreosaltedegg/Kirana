    },
    {
      "id": "scene22",
      "background": "bg_st1_sc2_1",
      "backgroundBlur": true,
      "characterImage": "ch_st1_sc4",
      "characterPlacement": {
        "width": 402,
        "height": null,
        "xOffset": 0,
        "yOffset": 0
      },
      "voiceover": "17",
      "speaker": null,
      "text": "Manakah penyebutan yang benar?",
      "choices": [
      { "text": "Congklak", "nextSceneId": "scene23" },
      { "text": "Manggaleceng", "nextSceneId": "scene23" },
      { "text": "Daku", "nextSceneId": "scene23" }
      ],
      "next": null
    },
    {
      "id": "scene23",
      "background": "bg_st1_sc1_1",
      "backgroundBlur": false,
      "characterImage": "ch_st1_sc4",
      "characterPlacement": {
        "width": 402,
        "height": null,
        "xOffset": 0,
        "yOffset": 0
      },
      "speaker": null,
      "text": "Semua jawaban benar, yang berbeda hanya cara penyebutan congkak di berbagai daerah. Dalam bahasa Indonesia kata ‘congkak’ ditulis tanpa huruf ‘L’. Banyak daerah dari Sumatra menyebutnya ‘congklak’. ‘Daku’ merupakan sebutan Sunda dan ‘Maggaleceng’ sebutan dari Indonesia Timur.",
      "choices": null,
      "next": "scene24"
    },
    {
      "id": "scene24",
      "background": "bg_st1_sc2",
      "backgroundBlur": true,
      "characterImage": "ch_st1_sc15",
      "characterPlacement": {
        "width": 250,
        "height": null,
        "xOffset": 0,
        "yOffset": -25
      },
      "voiceover": "18",
      "speaker": "Waha",
      "text": "Oooh, lalu kerang-kerang kecil ini untuk apa?",
      "choices": null,
      "next": "scene25"
    },
    {
      "id": "scene25",
      "background": "bg_st1_sc2",
      "backgroundBlur": true,
      "characterImage": "ch_st1_sc13",
      "characterPlacement": {
        "width": 250,
        "height": null,
        "xOffset": 0,
        "yOffset": 5
      },
      "voiceover": "19",
      "speaker": "Encep",
      "text": "Kerang-kerang kecil ini kita letakkan di lubang yang berada di sampingnya, searah jarum jam. Namun, setiap lubang hanya boleh diisi satu kerang saja. Ibuku bilang congklak ini mengajarkan kita untuk bisa berbagi secukupnya.",
      "choices": null,
      "next": "scene26"
    },
